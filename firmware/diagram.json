{
  "version": 1,
  "author": "AgriSense Core Engineering",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 40,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": 20,
      "left": 220,
      "attrs": { "temperature": "24.5", "humidity": "58" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "soil_sensor",
      "top": 90,
      "left": -180,
      "attrs": { "value": "2200" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay",
      "top": 160,
      "left": 220,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "pump_led",
      "top": 290,
      "left": 240,
      "attrs": { "color": "blue", "label": "PUMP" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht:VCC", "esp:3V3", "red", [ "v-15", "h-180" ] ],
    [ "dht:GND", "esp:GND.1", "black", [ "v-10", "h-140" ] ],
    [ "dht:SDA", "esp:4", "green", [ "v15", "h-120" ] ],
    [ "soil_sensor:VCC", "esp:3V3", "red", [ "v-20", "h80" ] ],
    [ "soil_sensor:SIG", "esp:34", "yellow", [ "v0" ] ],
    [ "soil_sensor:GND", "esp:GND.2", "black", [ "v20", "h80" ] ],
    [ "relay:VCC", "esp:5V", "red", [ "h-40", "v80" ] ],
    [ "relay:GND", "esp:GND.3", "black", [ "h-20" ] ],
    [ "relay:IN", "esp:26", "blue", [ "h-60", "v-40" ] ],
    [ "relay:COM", "esp:5V", "red", [ "h-30", "v60" ] ],
    [ "relay:NO", "pump_led:A", "green", [ "v30" ] ],
    [ "pump_led:C", "esp:GND.3", "black", [ "h-60", "v-80" ] ]
  ],
  "dependencies": {
    "DHT sensor library": "1.4.6",
    "Adafruit Unified Sensor": "1.1.14"
  }
}
