# AgriSense Environment Configuration Template
# -------------------------------------------------------------
# Copy this file to `.env` and populate your secrets.
# IMPORTANT: `.env` is ignored by git and must NEVER be committed.
# -------------------------------------------------------------

# Google Gemini API Key (Required for AI Agronomist Chat)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Hardware Node Endpoints (Optional overrides)
ESP32_IRRIGATION_HOST=192.168.4.1
ESP32_VISION_HOST=192.168.4.2

# AWS Cloud Deployment (For SAM local testing)
AWS_REGION=us-east-1

